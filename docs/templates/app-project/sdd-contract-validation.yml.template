name: SDD Contract Validation

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  sdd-contract-validation:
    name: SDD Contract Validation
    runs-on: ubuntu-latest
    steps:
      # actions/checkout v7.0.1
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false

      # actions/setup-python v7.0.0
      - name: Set up Python 3.13
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97
        with:
          python-version: "3.13"

      - name: Validate SDD artifacts and gate handoffs
        run: python3 scripts/artifacts.py validate

      - name: Run app-declared required checks and capture revision evidence
        if: always()
        env:
          SDD_CI_EVIDENCE_DIR: ${{ runner.temp }}/sdd-required-checks-${{ github.run_id }}-${{ github.run_attempt }}
        run: python3 scripts/ci_checks.py

      # actions/upload-artifact v7.0.0
      - name: Preserve required-check evidence even when a check fails
        if: always()
        uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f
        with:
          name: sdd-required-check-evidence-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/sdd-required-checks-${{ github.run_id }}-${{ github.run_attempt }}/
          if-no-files-found: warn
          retention-days: 90
