{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/naelmusleh/adversarial-sdd-boilerplate/blob/main/docs/framework/schemas/assumption-experiment-v1.schema.json",
  "title": "Assumption and experiment record bundle v1",
  "type": "object",
  "required": ["schema_version", "assumptions", "experiments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "experiments": {"type": "array", "items": {"$ref": "#/$defs/experiment"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]{3}$"},
    "assumption": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim", "source_type", "confidence", "limits", "impact_if_wrong", "confirmation_method", "disproof_method", "owner", "due_date", "review_date", "requirement_ids", "task_ids", "task_effects", "blocking_state", "status", "status_history", "evidence", "disposition", "gate_supporting"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "claim": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["owner-statement", "observed-fact", "external-evidence", "inference"]},
        "confidence": {"type": "string", "minLength": 1}, "limits": {"type": "string", "minLength": 1},
        "impact_if_wrong": {"type": "string", "minLength": 1}, "confirmation_method": {"type": "string", "minLength": 1}, "disproof_method": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}, "due_date": {"type": "string", "format": "date"}, "review_date": {"type": "string", "format": "date"},
        "requirement_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "task_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "task_effects": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["task_id", "depends_on_assumption", "state", "reason", "reassessment_trigger"], "properties": {"task_id": {"$ref": "#/$defs/id"}, "depends_on_assumption": {"type": "boolean"}, "state": {"enum": ["blocked", "conditional", "unblocked"]}, "reason": {"type": "string", "minLength": 1}, "reassessment_trigger": {"type": "string", "minLength": 1}}}},
        "blocking_state": {"enum": ["blocked", "conditional", "unblocked"]}, "status": {"enum": ["open", "confirmed", "disproved", "superseded", "retired"]},
        "status_history": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["status", "recorded_at", "reason"], "properties": {"status": {"enum": ["open", "confirmed", "disproved", "superseded", "retired"]}, "recorded_at": {"type": "string", "format": "date"}, "reason": {"type": "string", "minLength": 1}}}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "disposition": {"type": ["string", "null"]},
        "previous_status": {"type": ["string", "null"]}, "changed_at": {"type": ["string", "null"], "format": "date"}, "gate_supporting": {"type": "boolean"}
      }
    },
    "experiment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "assumption_id", "hypothesis", "prediction", "wrong_if", "method", "sample_data_limits", "privacy_handling", "read_date", "owner", "status", "decision_rule", "evidence", "outcome"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "assumption_id": {"$ref": "#/$defs/id"}, "hypothesis": {"type": "string", "minLength": 1},
        "prediction": {"type": "string", "minLength": 1}, "wrong_if": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1},
        "sample_data_limits": {"type": "string", "minLength": 1}, "privacy_handling": {"type": "string", "minLength": 1}, "read_date": {"type": ["string", "null"], "format": "date"},
        "owner": {"type": "string", "minLength": 1}, "status": {"enum": ["proposed", "running", "completed", "abandoned"]},
        "decision_rule": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "outcome": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/outcome"}]}, "decision_id": {"$ref": "#/$defs/id"}, "previous_status": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "source", "observed_at", "limits", "result"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["owner-statement", "observed", "external", "inference", "synthetic"]}, "source": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date"}, "limits": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}}
    },
    "outcome": {"type": "object", "additionalProperties": false, "required": ["observed_at", "actual_result", "evidence_ids"], "properties": {"observed_at": {"type": "string", "format": "date"}, "actual_result": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}}}
  }
}
