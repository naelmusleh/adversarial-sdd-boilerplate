{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adversarial-sdd:fw030:request:1.0",
  "title": "FW-030 host-neutral execution request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "source", "execution_context", "profile", "workload", "policy", "required_capabilities"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "invocation_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "tree_sha256"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "tree_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "execution_context": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "provider_context"],
      "properties": {
        "kind": { "enum": ["local", "hosted"] },
        "provider_context": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["provider", "workflow", "job", "run_id", "attempt", "event", "ref", "url"],
          "properties": {
            "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
            "workflow": { "type": "string", "minLength": 1, "maxLength": 512 },
            "job": { "type": "string", "minLength": 1, "maxLength": 256 },
            "run_id": { "type": "string", "pattern": "^[0-9]{1,32}$" },
            "attempt": { "type": "integer", "minimum": 1 },
            "event": { "type": "string", "minLength": 1, "maxLength": 128 },
            "ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "url": { "type": "string", "format": "uri", "maxLength": 2048 }
          }
        },
        "absence_reason": { "type": "string", "enum": ["local_execution_has_no_provider_run"] }
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "argv", "executable", "working_directory"],
      "properties": {
        "image": { "type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$", "maxLength": 1024 },
        "argv": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "executable": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "working_directory": { "type": "string", "pattern": "^/", "maxLength": 1024 }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "uid", "gid", "mounts", "network", "secrets", "limits", "cancellation", "evidence"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "uid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "gid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "mounts": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "source", "target", "mode"],
            "properties": {
              "kind": { "enum": ["input", "output"] },
              "source": { "type": "string", "pattern": "^/", "maxLength": 1024 },
              "target": { "type": "string", "pattern": "^/", "maxLength": 1024 },
              "mode": { "enum": ["read_only", "write_only"] }
            }
          }
        },
        "network": { "const": "disabled" },
        "secrets": { "const": "disabled" },
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["cpu_millis", "memory_mb", "process_count", "disk_mb", "wall_seconds"],
          "properties": {
            "cpu_millis": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "memory_mb": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "process_count": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "disk_mb": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "wall_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 }
          }
        },
        "cancellation": { "enum": ["terminate_then_kill_within_wall_limit"] },
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "max_output_bytes", "case_ids"],
          "properties": {
            "mode": { "const": "allowlisted_redacted" },
            "max_output_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
            "case_ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$" } }
          }
        }
      }
    },
    "required_capabilities": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
