{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adversarial-sdd.example/schemas/profile-selection-manifest-v1.schema.json",
  "title": "Adversarial SDD generated profile selection manifest v1",
  "description": "Architecture contract for the initializer's reproducible output inventory and truthful prerequisite/check observations. Not yet emitted by the initializer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "framework_revision", "core_contract_version", "selected_profiles", "generated_files", "prerequisites", "profile_checks"],
  "properties": {
    "schema_version": { "const": "1" },
    "framework_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "core_contract_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "selected_profiles": {
      "description": "Map key is profile ID, so a profile cannot be selected more than once.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,63}$" },
      "additionalProperties": { "$ref": "#/$defs/selectedProfile" }
    },
    "generated_files": {
      "description": "Map key is the unique generated relative path.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/safePath" },
      "additionalProperties": { "$ref": "#/$defs/generatedFile" }
    },
    "prerequisites": {
      "description": "Map key is `<profile-id>/<prerequisite-name>`.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,63}/[^/]+$" },
      "additionalProperties": { "$ref": "#/$defs/prerequisite" }
    },
    "profile_checks": {
      "description": "Selected profile check declarations keyed by profile ID and check ID; unsupported checks remain explicit.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,63}$" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "additionalProperties": { "$ref": "#/$defs/profileCheck" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safePath": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$)|\\\\)" } },
    "selectedProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_version", "manifest_sha256"],
      "properties": {
        "profile_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "manifest_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "generatedFile": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "owner"],
      "properties": {
        "sha256": { "$ref": "#/$defs/digest" },
        "owner": {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "enum": ["core", "profile"] }, "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" } },
          "allOf": [
            { "if": { "properties": { "kind": { "const": "profile" } }, "required": ["kind"] }, "then": { "required": ["profile_id"] }, "else": { "not": { "required": ["profile_id"] } } }
          ]
        }
      }
    },
    "prerequisite": {
      "type": "object", "additionalProperties": false, "required": ["required", "state"],
      "properties": { "required": { "type": "boolean" }, "state": { "enum": ["available", "missing", "not-checked"] }, "observed_version": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } },
      "allOf": [
        { "if": { "properties": { "state": { "const": "available" } }, "required": ["state"] }, "then": { "required": ["observed_version"], "not": { "required": ["reason"] } }, "else": { "required": ["reason"], "not": { "required": ["observed_version"] } } }
      ]
    },
    "profileCheck": {
      "type": "object", "additionalProperties": false, "required": ["status", "required"],
      "properties": {
        "status": { "enum": ["applicable", "unsupported"] },
        "required": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "applicable" } }, "required": ["status"] }, "then": { "required": ["command", "scope"], "not": { "required": ["reason"] } }, "else": { "required": ["reason"], "not": { "anyOf": [{ "required": ["command"] }, { "required": ["scope"] }] } } }
      ]
    }
  }
}
