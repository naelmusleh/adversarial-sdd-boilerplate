{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adversarial-sdd:fw031:budget-policy:1.0",
  "title": "FW-031 versioned per-run budget policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_revision", "policy_digest", "source_revision", "run_scope", "nested_run_accounting", "reset_behavior", "override_policy", "limits"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "policy_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "policy_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "policy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_revision": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "run_scope": { "enum": ["single-run", "agent-tree"] },
    "nested_run_accounting": { "enum": ["per-run-exclusive", "aggregate-at-root", "unavailable"] },
    "reset_behavior": { "const": "new-run-only" },
    "override_policy": { "const": "disabled" },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "unit", "scope", "requested", "measurement_source", "capability", "start_event", "reset_behavior", "warning_threshold", "exhaustion_threshold", "threshold_action", "unavailable_behavior"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
          "kind": { "enum": ["wall-clock", "retry-count", "tool-invocation", "resource", "spend"] },
          "unit": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$" },
          "scope": { "enum": ["run", "run-tree"] },
          "requested": { "type": "boolean" },
          "measurement_source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "enum": ["coordinator", "controller", "host-meter", "provider-meter", "unselected", "synthetic-fixture"] },
              "id": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          },
          "capability": { "enum": ["enforced", "advisory", "unavailable"] },
          "start_event": { "enum": ["run-start", "agent-start", "first-work-item"] },
          "reset_behavior": { "const": "new-run-only" },
          "warning_threshold": { "type": ["number", "null"], "minimum": 0 },
          "exhaustion_threshold": { "type": ["number", "null"], "minimum": 0 },
          "threshold_action": { "enum": ["warn", "request-cancellation", "record-exhaustion"] },
          "unavailable_behavior": { "enum": ["block-run", "continue-advisory", "disable-limit"] }
        }
      }
    }
  }
}
