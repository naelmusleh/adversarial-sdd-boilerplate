{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adversarial-sdd.example/schemas/fw028/measurement-result-v1.schema.json",
  "title": "FW-028 normalized quality and provider result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "source_sha", "profile_sha256", "manifest_sha256", "adapter", "overall_state", "metrics", "provider_checks", "evidence_ref", "observed_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "repository": {"type": "string", "format": "uri"},
    "source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "profile_sha256": {"$ref": "#/$defs/digest"},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["id", "version", "evaluator_revision"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "evaluator_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}},
    "overall_state": {"enum": ["pass", "fail", "stale", "in-progress", "blocked", "unavailable"]},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "provider_checks": {"type": "array", "items": {"$ref": "#/$defs/providerCheck"}},
    "evidence_ref": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metric": {"type": "object", "additionalProperties": false, "required": ["metric_id", "required", "state", "scope"], "properties": {"metric_id": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "state": {"enum": ["pass", "fail", "unavailable", "in-progress", "stale"]}, "value": {"type": "number"}, "unavailable_reason": {"type": "string", "minLength": 1}, "scope": {"type": "object", "additionalProperties": false, "required": ["included", "excluded"], "properties": {"included": {"type": "array", "items": {"type": "string"}}, "excluded": {"type": "array", "items": {"type": "string"}}}}}, "allOf": [{"if": {"properties": {"state": {"const": "unavailable"}}, "required": ["state"]}, "then": {"required": ["unavailable_reason"], "not": {"required": ["value"]}}}, {"if": {"properties": {"state": {"const": "pass"}}, "required": ["state"]}, "then": {"required": ["value"]}}]},
    "providerCheck": {"type": "object", "additionalProperties": false, "required": ["provider", "repository", "check_id", "run_id", "conclusion", "head_sha"], "properties": {"provider": {"type": "string", "minLength": 1}, "repository": {"type": "string", "format": "uri"}, "check_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "conclusion": {"enum": ["success", "failure", "cancelled", "timed_out", "action_required", "stale", "in_progress", "unavailable"]}, "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}}
  }
}
