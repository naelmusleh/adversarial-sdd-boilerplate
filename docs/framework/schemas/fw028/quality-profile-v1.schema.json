{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adversarial-sdd.example/schemas/fw028/quality-profile-v1.schema.json",
  "title": "FW-028 app quality profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "owner_ref", "adapter", "risk_dimensions", "metric_rules", "path_rules", "escalation_floors", "threshold_change_policy"],
  "properties": {
    "schema_version": {"const": "1"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "profile_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "owner_ref": {"type": "string", "minLength": 1},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "risk_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["behavior-criticality", "data-security-consequence", "failure-severity", "change-type", "testability"]}},
    "metric_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metricRule"}},
    "path_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathRule"}},
    "escalation_floors": {"type": "array", "items": {"$ref": "#/$defs/escalationFloor"}},
    "threshold_change_policy": {"const": "reviewed-profile-revision-only"},
    "supersedes": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "metricRule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "metric_id", "risk_tier", "required", "availability", "scope", "rationale"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
        "metric_id": {"type": "string", "minLength": 1},
        "risk_tier": {"enum": ["low", "medium", "high", "critical"]},
        "required": {"type": "boolean"},
        "availability": {"enum": ["supported", "unavailable"]},
        "threshold": {"type": "number", "minimum": 0, "maximum": 100},
        "scope": {"type": "object", "additionalProperties": false, "required": ["include", "exclude"], "properties": {"include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
        "rationale": {"type": "string", "minLength": 1},
        "unavailable_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"availability": {"const": "supported"}}, "required": ["availability"]}, "then": {"required": ["threshold"], "not": {"required": ["unavailable_reason"]}}},
        {"if": {"properties": {"availability": {"const": "unavailable"}}, "required": ["availability"]}, "then": {"required": ["unavailable_reason"], "not": {"required": ["threshold"]}}}
      ]
    },
    "pathRule": {"type": "object", "additionalProperties": false, "required": ["pattern", "classification"], "properties": {"pattern": {"type": "string", "minLength": 1}, "classification": {"enum": ["presentation", "configuration", "domain", "authorization", "tenancy", "migration", "security"]}, "reason": {"type": "string", "minLength": 1}}},
    "escalationFloor": {"type": "object", "additionalProperties": false, "required": ["match_kind", "match", "minimum_tier"], "properties": {"match_kind": {"enum": ["path-pattern", "criterion-tag"]}, "match": {"type": "string", "minLength": 1}, "minimum_tier": {"enum": ["low", "medium", "high", "critical"]}}}
  }
}
