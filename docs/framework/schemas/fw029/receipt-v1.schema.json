{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adversarial-sdd:fw029:receipt:1.0",
  "title": "FW-TASK-029 signed CI evidence receipt payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "source",
    "gate_contract",
    "workflow",
    "provider_run",
    "required_check_manifest_sha256",
    "checks",
    "evidence",
    "issuer",
    "issued_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "owner", "name", "id"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 255 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 255 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "id": { "type": "string", "pattern": "^[0-9]{1,32}$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "ref"],
      "properties": {
        "sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "gate_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision_sha", "identity"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\.github/workflows/[^\\s]+\\.ya?ml$", "maxLength": 1024 },
        "revision_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "identity": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "provider_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "run_id", "attempt", "event", "ref", "url"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "run_id": { "type": "string", "pattern": "^[0-9]{1,32}$" },
        "attempt": { "type": "integer", "minimum": 1 },
        "event": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "url": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "required_check_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_id", "provider_check_id", "name", "conclusion", "head_sha"],
        "properties": {
          "logical_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "provider_check_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "name": { "type": "string", "minLength": 1, "maxLength": 512 },
          "conclusion": { "type": "string", "enum": ["success"] },
          "head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "sha256", "reference"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "reference": { "type": "string", "format": "uri", "maxLength": 2048 }
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "identity"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "identity": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
