{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adversarial-sdd:fw029:verification-policy:1.0",
  "title": "FW-TASK-029 caller-supplied verification policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "repository",
    "gate_contract",
    "workflow",
    "required_check_manifest_sha256",
    "required_checks",
    "issuer",
    "verification_mode"
  ],
  "properties": {
    "policy_version": { "const": "1.0" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "owner", "name", "id"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 255 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 255 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "id": { "type": "string", "pattern": "^[0-9]{1,32}$" }
      }
    },
    "gate_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision_sha", "identity"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\.github/workflows/[^\\s]+\\.ya?ml$", "maxLength": 1024 },
        "revision_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "identity": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "required_check_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_id", "name"],
        "properties": {
          "logical_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "name": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "identity", "trust_root_sha256"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "identity": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "trust_root_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "verification_mode": { "const": "read-only-repeatable" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
