# Public Supabase project configuration. The publishable key is designed for
# browser use; database authorization must be enforced by Supabase RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials are optional until an approved feature requires them.
# Never prefix privileged credentials with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
